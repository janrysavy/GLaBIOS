@ECHO OFF

REM Build the pinned PyPC emulator profile from GLaBIOS v0.4.2.
IF EXIST GLABIOS.OBJ DEL GLABIOS.OBJ
IF EXIST GLABIOS.EXE DEL GLABIOS.EXE
IF EXIST GLABIOS.ROM DEL GLABIOS.ROM

MASM /DVER_NUM="0.4.2" /DVER_DATE="04/05/26" /DARCH_TYPE="E" /DARCH_SUB_TYPE="K" GLABIOS;
IF ERRORLEVEL 1 GOTO FAIL
LINK GLABIOS;
IF ERRORLEVEL 1 GOTO FAIL
GLA2ROM\GLA2ROM GLABIOS.EXE GLABIOS.ROM
IF ERRORLEVEL 1 GOTO FAIL

ECHO Built GLABIOS.ROM for PyPC.
GOTO DONE

:FAIL
ECHO PyPC GLaBIOS build failed.
EXIT 1

:DONE
